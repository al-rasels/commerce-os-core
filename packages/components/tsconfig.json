{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@commerceos/shared-types": ["../shared-types/src/index.ts", "../shared-types/dist/index.d.ts"]
    }
  },
  "include": [
    "*.ts",
    "*.tsx"
  ],
  "exclude": [
    "*.spec.ts",
    "*.spec.tsx",
    "vitest.setup.ts"
  ]
}