# Common
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/commerceos?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Security
JWT_SECRET="super-secret-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption (for sensitive data at rest)
ENCRYPTION_KEY="32-char-min-encryption-key-here-change"

# Sentry
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Resend (email)
RESEND_API_KEY=""

# AWS / S3
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""

# URLs
API_URL="http://localhost:3000"
STOREFRONT_URL="http://localhost:3001"
ADMIN_URL="http://localhost:3002"
