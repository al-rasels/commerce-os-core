# Common
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:dev@localhost:5432/commerceos?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
# BullMQ queue alternate connection (defaults to REDIS_URL if not set)
API_REDIS_HOST="localhost"
API_REDIS_PORT="6379"

# Security
JWT_SECRET="change-me-in-production"

# CORS (comma-separated allowlist; required in production, never use * with credentials)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:5173"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Meilisearch (optional — search sync worker)
MEILISEARCH_HOST="http://127.0.0.1:7700"
MEILISEARCH_KEY=""

# Storefront (Next.js public env vars)
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Transactional email (Resend). Leave RESEND_API_KEY empty to suppress sending (dev).
RESEND_API_KEY=""
EMAIL_FROM="CommerceOS <onboarding@resend.dev>"

# Public storefront origin used to build email links (reset password / invite)
STOREFRONT_URL="http://localhost:3001"

# Page Builder draft preview
PREVIEW_SECRET=""

# Admin (Vite) — storefront preview links + draft-preview secret (must match PREVIEW_SECRET)
VITE_STOREFRONT_URL="http://localhost:3001"
VITE_PREVIEW_SECRET=""